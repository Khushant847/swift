// Swift Instruments — Prisma schema (SQLite local dev).
// For production PostgreSQL, use prisma/schema.postgres.prisma (same models,
// native enums + provider = "postgresql"). Keep both in sync when editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── RBAC / Auth ─────────────────────────────────────────────
model Admin {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  role         String   @default("content_editor") // super_admin | content_editor
  isActive     Boolean  @default(true)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs    AuditLog[]

  @@index([email])
}

// One-time email OTP codes for MFA login flow
model EmailOtp {
  id        String   @id @default(cuid())
  adminId   String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
}

// ─── Header / Footer navigation ──────────────────────────────
model NavigationLink {
  id       String  @id @default(cuid())
  title    String
  url      String
  position Int     @default(0)
  location String  @default("header") // header | footer
  isActive Boolean @default(true)

  @@index([location, position])
}

// ─── Hero carousel ───────────────────────────────────────────
model HeroBanner {
  id              String   @id @default(cuid())
  title           String?
  subtitle        String?
  ctaLabel        String?
  ctaUrl          String?
  mediaUrl        String
  mediaType       String   @default("image") // image | video
  displayOrder    Int      @default(0)
  intervalSeconds Int      @default(5000)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([displayOrder])
}

// ─── Why Choose Us (USPs) ────────────────────────────────────
model WhyChooseUs {
  id           String  @id @default(cuid())
  title        String
  description  String
  icon         String  @default("BadgeCheck") // lucide icon name
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
}

// ─── Products & Services ─────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  shortDesc   String?
  description String
  imageUrl    String?
  specs       String? // JSON string of key/value specs
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isFeatured])
  @@index([isActive])
}

// ─── Company info (About / Address / Map / Founder) ──────────
model CompanyInfo {
  id        String   @id @default(cuid())
  keyName   String   @unique // founder_name, founder_bio, history, address, phone, fax, mobile, map_embed, email
  keyValue  String
  updatedAt DateTime @updatedAt
}

// ─── Upcoming products (R&D teasers) ─────────────────────────
model UpcomingProduct {
  id             String   @id @default(cuid())
  title          String
  teaserDesc     String
  expectedLaunch String   @default("Coming soon")
  imageUrl       String?
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ─── Internal gallery ────────────────────────────────────────
model GalleryMedia {
  id          String   @id @default(cuid())
  mediaUrl    String
  mediaType   String   @default("image") // image | video
  categoryTag String   @default("Office") // Lab | Office | Team | Events
  caption     String?
  uploadedAt  DateTime @default(now())

  @@index([categoryTag])
}

// ─── Reviews (Google Places sync + manual) ───────────────────
model Review {
  id              String   @id @default(cuid())
  authorName      String
  rating          Int      @default(5)
  text            String
  profilePhotoUrl String?
  source          String   @default("manual") // manual | google
  googleReviewId  String?  @unique
  isFeatured      Boolean  @default(false)
  isHidden        Boolean  @default(false)
  reviewTime      DateTime @default(now())
}

// ─── Enquiries CRM ───────────────────────────────────────────
model Enquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  companyName String?
  subject     String?
  message     String
  status      String   @default("new") // new | contacted | closed
  notes       String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Central Media Manager ───────────────────────────────────
model Media {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String
  mimeType     String
  size         Int
  folder       String   @default("general")
  tags         String? // comma separated
  width        Int?
  height       Int?
  uploadedAt   DateTime @default(now())

  @@index([folder])
}

// ─── Generic key/value settings ──────────────────────────────
model Setting {
  id        String   @id @default(cuid())
  keyName   String   @unique // enquiry_recipients, footer_text, social_links, copyright, backup_config ...
  keyValue  String
  updatedAt DateTime @updatedAt
}

// ─── Audit log ───────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminEmail String
  action     String // create | update | delete | login | logout | config | upload
  entity     String // product | banner | enquiry ...
  entityId   String?
  details    String? // JSON summary/diff
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([createdAt])
}
