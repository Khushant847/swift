# Base URL for the API. Leave EMPTY in dev (Vite proxies /api and /uploads to
# the backend, keeping auth cookies same-origin). For a deployed SPA served
# from a different origin, set the full backend URL, e.g. https://api.example.com
VITE_API_URL=

# Dev proxy target for the backend
VITE_PROXY_TARGET=http://localhost:4000
