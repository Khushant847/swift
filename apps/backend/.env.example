# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of THIS api (used to build absolute media URLs)
PUBLIC_BASE_URL=http://localhost:4000

# ─── Database ──────────────────────────────────────────────
# Local dev (SQLite). For production switch provider to "postgresql" and use:
# DATABASE_URL=postgresql://user:pass@localhost:5432/swift?schema=public
DATABASE_URL="file:./dev.db"

# ─── Auth / Sessions ───────────────────────────────────────
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_MINUTES=20
COOKIE_NAME=swift_at
COOKIE_DOMAIN=
# Comma separated list of allowed browser origins (web + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Uploads (STORAGE_DRIVER=local|s3|cloudinary) ──────────
STORAGE_DRIVER=local
UPLOAD_MAX_MB=25
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Email (dev = logs to console) ─────────────────────────
MAIL_DRIVER=console
MAIL_FROM="Swift Instruments <no-reply@swiftinstruments.in>"
# Set MAIL_DRIVER=smtp and fill these for real delivery
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ─── Rate limiting ─────────────────────────────────────────
# Leave empty to use the in-memory store (single instance). Set for multi-instance.
# REDIS_URL=

# ─── Google integrations (optional) ────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
CAPTCHA_SECRET=
