# ─── Public website environment ──────────────────────────────────────────────
# Local development values are shown below. In production (Vercel, VPS, etc.)
# set these in the hosting dashboard — never commit a real .env file.
#
# Vercel: Project → Settings → Environment Variables
#   NEXT_PUBLIC_SITE_URL=https://yourdomain.com
#   API_URL=https://api.yourdomain.com
#   NEXT_PUBLIC_API_URL=
#   NEXT_PUBLIC_REVALIDATE=60
#   NEXT_PUBLIC_COMPANY_REVALIDATE=15
#   API_FETCH_TIMEOUT_MS=5000

# URL the browser uses to reach the API (for client-side fetches / images).
# Leave EMPTY in production to call same-origin /api/v1/* — next.config.mjs
# proxies those paths to the backend (API_URL), which also keeps CORS and
# client-IP rate limiting simple. Set it only for cross-origin deployments.
NEXT_PUBLIC_API_URL=
# URL the Next.js server uses to reach the API (SSR + build-time fetch).
# Local: http://localhost:4000. Production: the public HTTPS backend URL.
API_URL=http://localhost:4000
# Public site URL — used for metadataBase, canonicals, robots.txt and sitemap.
# MUST be the final custom domain in production (https, no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Revalidation window (seconds) for ISR-cached public content
NEXT_PUBLIC_REVALIDATE=60
# Branding/contact (company-info) revalidation window (seconds). Keep this
# short so an admin logo/contact change reaches the header + footer quickly.
NEXT_PUBLIC_COMPANY_REVALIDATE=15
# Per-attempt timeout for server-side API fetches (ms). Transient failures are
# retried up to 4 times at runtime (2 during `next build`).
API_FETCH_TIMEOUT_MS=5000
